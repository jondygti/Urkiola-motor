# Plantilla de nombres de variables para Render STAGING.
# No copiar secretos reales al repositorio.

NODE_ENV=production

# PostgreSQL Supabase: conexión directa o pooler en modo sesión.
DATABASE_URL=

# Mientras siga activa la autenticación propia.
JWT_SECRET=
SESION_DIAS=30

# Staging siempre arranca vacío; nunca con datos demo.
URKIOLA_SEMILLA=vacia
URKIOLA_ADMIN_EMAIL=
URKIOLA_ADMIN_PASSWORD=

# Origen(es) web permitidos, separados por coma si hubiera más de uno.
CORS_ORIGEN=
PUBLIC_URL=

# Supabase Storage privado.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=urkiola-fotos
URKIOLA_MAX_FOTO_MB=8

# Correo de recuperación de contraseña.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=

# Avisos Expo. Poner 0 para desactivarlos durante una prueba concreta.
EXPO_PUSH=1

# Render proporciona PORT; no hace falta fijarlo normalmente.
