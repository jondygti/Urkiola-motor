# Copiar a .env en el servidor y poner contraseñas de verdad.
POSTGRES_USER=urkiola
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=urkiola

MINIO_ROOT_USER=urkiola
MINIO_ROOT_PASSWORD=cambia-esta-contrasena-tambien

# Secreto para firmar los tokens de sesión de la API.
# Genéralo con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Dirección pública del panel, para permitir el navegador desde ahí.
PUBLIC_URL=https://urkiolacarservice.com

# Primer administrador: se crea al arrancar por primera vez.
# Sin esto no habría forma de entrar en un sistema recién instalado.
URKIOLA_ADMIN_EMAIL=admin@urkiolacarservice.com
URKIOLA_ADMIN_PASSWORD=cambia-esta-contrasena-la-primera-vez
