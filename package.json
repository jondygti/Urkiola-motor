{
  "name": "urkiola-car-service",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npm run fuente && expo export --platform web --output-dir dist --clear",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify/run.mjs",
    "verify:api": "node scripts/verify/backend.mjs",
    "test:sync": "npm --prefix server run build && node --test scripts/verify/sincronizacion.test.mjs",
    "server": "npm --prefix server run dev",
    "server:test": "npm --prefix server test",
    "lint": "expo lint",
    "icons": "node scripts/generate-icons.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "fuente": "node scripts/generar-fuente.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.12",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "expo-file-system": "57.0.5",
    "expo-secure-store": "57.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
