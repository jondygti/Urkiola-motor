# Copia este fichero a .env y ajusta los valores.
#
# Si EXPO_PUBLIC_API_URL está vacío la app arranca en MODO DEMO:
# usa los datos de ejemplo incluidos y guarda los cambios en el dispositivo.
# En cuanto apuntes a un backend real, la app usa la API.
EXPO_PUBLIC_API_URL=

# Identificadores de EAS (los rellena `eas init`).
EAS_PROJECT_ID=
EAS_OWNER=
