{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "platforms": [
        "android"
      ],
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "platforms": [
        "android"
      ],
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "platforms": [
        "android"
      ],
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
